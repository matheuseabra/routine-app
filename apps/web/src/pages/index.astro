---
import Brand from "@/components/Brand.astro";
import Phone from "@/components/Phone.astro";
import DownloadButton from "@/components/DownloadButton";
import FAQ from "@/components/FAQ";
import { FiArrowUpRight, FiCheck, FiList, FiTrendingUp } from "react-icons/fi";
import home from "@/assets/home.png";
import habits from "@/assets/habits.png";
import insights from "@/assets/insights.png";
import "@/styles/global.css";
import "@/styles/landing.css";

const features = [
  {
    title: "A clear place for\nyour everyday.",
    description: "The morning walk. A few pages. A moment to stretch. Keep the things you want to make time for together, in one simple list.",
    image: home, alt: "Routine’s daily task list with three completed tasks and an evening stretch still to do.",
  },
  {
    title: "Small steps.\nA rhythm that sticks.",
    description: "You don’t need to do everything at once. See what you’ve done and what’s up next, so it’s easy to keep moving at your own pace.",
    image: habits, alt: "Routine Habits showing three of four tasks completed and the next habit to work on.",
  },
  {
    title: "Your effort,\nin perspective.",
    description: "Look back on your week or zoom out to the month. Check-ins, active days, and streaks help you see the consistency you’re building.",
    image: insights, alt: "Routine Insights with a seven-day streak, fourteen completed tasks, and a daily activity chart. Sample data.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f7" />
    <meta name="description" content="Make room for a better everyday. Routine brings your daily tasks, habits, and progress together in a calm, simple iPhone app." />
    <meta property="og:title" content="Routine — Small steps. Better days." />
    <meta property="og:description" content="A little structure. A little more space for what matters. Meet Routine for iPhone." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Routine — Small steps. Better days.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell nav-row">
        <Brand />
        <nav aria-label="Main navigation">
          <a class="nav-link" href="#how-it-works">How it works</a>
          <a class="nav-link" href="#faq">FAQ</a>
          <a class="nav-cta" href="#download">Get Routine <FiArrowUpRight aria-hidden="true" /></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="shell hero" aria-labelledby="hero-title" id="top">
        <div class="hero-copy">
          <h1 id="hero-title">Small steps.<br />Better days.</h1>
          <p class="body-copy">Make room for what matters. Routine brings your daily tasks, habits, and progress together in one calm place.</p>
          <div class="hero-actions">
            <DownloadButton client:load />
          </div>
        </div>
        <div class="hero-visual">
          <Phone image={home} alt="Routine on iPhone: a simple daily task list with morning walk, reading, water, and stretching. Sample tasks." priority />
        </div>
      </section>
      <section class="shell how-section" id="how-it-works" aria-labelledby="how-title">
        <h2 id="how-title">How Routine works</h2>
        <div class="steps-grid">
          <article class="how-step">
            <div class="step-meta"><span class="step-number">01</span><FiList aria-hidden="true" /></div>
            <h3>Choose what matters</h3>
            <p>Add the tasks and habits you want to make time for.</p>
          </article>
          <article class="how-step">
            <div class="step-meta"><span class="step-number">02</span><FiCheck aria-hidden="true" /></div>
            <h3>Check in as you go</h3>
            <p>Mark tasks complete and see what’s next in your routine.</p>
          </article>
          <article class="how-step">
            <div class="step-meta"><span class="step-number">03</span><FiTrendingUp aria-hidden="true" /></div>
            <h3>Notice your progress</h3>
            <p>Look back on your check-ins over the week or month.</p>
          </article>
        </div>
      </section>
      <section class="shell features" id="features" aria-labelledby="features-title">
        <div class="section-intro">
          <h2 id="features-title">Less noise. More routine.</h2>
          <p class="section-subtitle">A little structure for what matters today, with room to grow from there.</p>
        </div>
        {features.map((feature, index) => (
          <article class:list={["feature", { "feature-reverse": index === 1 }]}>
            <div class="feature-visual">
              <Phone image={feature.image} alt={feature.alt} />
            </div>
            <div class="feature-copy">
              <h3>{feature.title}</h3>
              <p class="body-copy">{feature.description}</p>
            </div>
          </article>
        ))}
      </section>
      <section class="shell faq-section" id="faq" aria-labelledby="faq-title">
        <div>
          <h2 id="faq-title">Simple by design.<br />Questions welcome.</h2>
        </div>
        <FAQ client:load />
      </section>
      <section class="shell closing" id="download" aria-labelledby="cta-title">
        <div class="closing-inner">
          <div class="closing-copy">
            <h2 id="cta-title">Make a little room<br />for a better everyday.</h2>
          </div>
          <div class="closing-action">
            <DownloadButton client:load />
          </div>
        </div>
      </section>
    </main>
    <footer class="shell footer">
      <Brand />
      <p>A little more intention, every day.</p>
      <div><span>© {new Date().getFullYear()} Routine</span><a href="#top">Back to top <FiArrowUpRight aria-hidden="true" /></a></div>
    </footer>
  </body>
</html>
