---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { image: ImageMetadata; alt: string; priority?: boolean; }
const { image, alt, priority = false } = Astro.props;
---
<div class="phone">
  <Image src={image} alt={alt} widths={[320, 640]} sizes="(max-width: 600px) 240px, 280px" width={320} format="webp" loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} />
</div>
