// Shared, non-secret defaults. Override locally in Local.xcconfig.
APP_DISPLAY_NAME = Routine
APP_BUNDLE_ID = com.example.RoutineApp
APP_TEST_BUNDLE_ID = com.example.RoutineAppTests
APP_UI_TEST_BUNDLE_ID = com.example.RoutineAppUITests
DEVELOPMENT_TEAM_ID =
AUTH_ENABLED = NO
ROUTINE_API_BASE_URL =
ROUTINE_API_BASE_URL[config=Debug] = http:/$()/localhost:3001

REVENUECAT_API_KEY =
REVENUECAT_APP_STORE_API_KEY =
REVENUECAT_ENTITLEMENT_ID = premium

#include? "Local.xcconfig"

REVENUECAT_BUNDLE_API_KEY[config=Debug] = $(REVENUECAT_API_KEY)
REVENUECAT_BUNDLE_API_KEY[config=Release] = $(REVENUECAT_APP_STORE_API_KEY)

INFOPLIST_KEY_AUTH_ENABLED = $(AUTH_ENABLED)
INFOPLIST_KEY_ROUTINE_API_BASE_URL = $(ROUTINE_API_BASE_URL)
INFOPLIST_KEY_REVENUECAT_ENTITLEMENT_ID = $(REVENUECAT_ENTITLEMENT_ID)
